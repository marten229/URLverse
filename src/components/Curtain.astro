---
/**
 * Cinema Curtain Component
 *
 * Provides the visual overlay and logic for the page transition animation.
 * Includes the HTML structure, critical CSS, and an inline synchronous script
 * to handle navigation state (preventing FOUC/flash of loading screen).
 */
---

<div id="curtain-overlay" aria-hidden="true">
    <div class="curtain curtain-left"></div>
    <div class="curtain curtain-right"></div>
    <!-- Loading indicator shown while curtain is closed -->
    <div class="curtain-loader">
        <div class="curtain-spinner"></div>
        <p class="curtain-loader-text">Generiere Seite…</p>
    </div>
</div>

<!--
  Inline synchronous script — runs before the first paint.
  If the user arrived via a curtain-intercepted link, snap the curtain
  to the closed position instantly so there is zero flash of the loading
  screen or the previous page's content.
-->
<script is:inline>
    (function () {
        if (sessionStorage.getItem("curtain-pre-closed") === "1") {
            // Add class to <html> so CSS can hide the loading state immediately,
            // before the #loading-state element even exists in the DOM.
            document.documentElement.classList.add("curtain-nav");
            var overlay = document.getElementById("curtain-overlay");
            if (overlay) overlay.classList.add("is-pre-closed");
        }
    })();
</script>

<style is:global>
    /*
   * When the user arrives via a curtain-intercepted link, the inline script
   * adds `curtain-nav` to <html> before the first paint. This rule hides the
   * loading spinner immediately so only the closed curtain (with its own
   * loading indicator) is visible.
   */
    html.curtain-nav .loading-container {
        display: none !important;
    }

    /* ── Cinema Curtain ──────────────────────────────────────────────────────── */

    #curtain-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        pointer-events: none;
    }

    .curtain {
        width: 50%;
        height: 100%;
        /* Vertical fold shading over a deep velvet base */
        background:
            repeating-linear-gradient(
                90deg,
                rgba(0, 0, 0, 0.22) 0px,
                rgba(0, 0, 0, 0) 8px,
                rgba(255, 255, 255, 0.04) 16px,
                rgba(0, 0, 0, 0) 24px
            ),
            linear-gradient(180deg, #5a0c16 0%, #8b1a2a 40%, #5a0c16 100%);
        position: relative;
        will-change: transform;
    }

    /* Gold fringe along the bottom of each panel */
    .curtain::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 28px;
        background: repeating-linear-gradient(
            90deg,
            #c8a84b 0px,
            #c8a84b 4px,
            transparent 4px,
            transparent 10px
        );
    }

    /*
   * Default state: panels are fully off-screen so the loading spinner is
   * visible when the page first renders. The close animation sweeps them in.
   */
    .curtain-left {
        transform: translateX(-110%);
        transform-origin: left center;
        box-shadow:
            inset -24px 0 48px rgba(255, 200, 100, 0.1),
            inset 0 0 80px rgba(0, 0, 0, 0.45);
    }

    .curtain-right {
        transform: translateX(110%);
        transform-origin: right center;
        box-shadow:
            inset 24px 0 48px rgba(255, 200, 100, 0.1),
            inset 0 0 80px rgba(0, 0, 0, 0.45);
    }

    /* ── Close keyframes (panels slide IN from off-screen) ────────────────── */

    @keyframes curtain-close-left {
        0% {
            transform: translateX(-110%);
        }
        100% {
            transform: translateX(0);
        }
    }

    @keyframes curtain-close-right {
        0% {
            transform: translateX(110%);
        }
        100% {
            transform: translateX(0);
        }
    }

    /*
   * Ease-in for closing: starts slow (curtain at rest), accelerates — like
   * a heavy velvet panel being pulled from a standstill.
   */
    #curtain-overlay.is-closing .curtain-left {
        animation: curtain-close-left 0.9s cubic-bezier(0.64, 0, 0.78, 0)
            forwards;
    }

    #curtain-overlay.is-closing .curtain-right {
        animation: curtain-close-right 0.9s cubic-bezier(0.64, 0, 0.78, 0)
            forwards;
    }

    /* Panels are fully closed — hold position while content loads */
    #curtain-overlay.is-closed .curtain-left {
        transform: translateX(0);
    }
    #curtain-overlay.is-closed .curtain-right {
        transform: translateX(0);
    }

    /* Instant closed state for navigation arrivals — no animation */
    #curtain-overlay.is-pre-closed .curtain-left {
        transform: translateX(0);
    }
    #curtain-overlay.is-pre-closed .curtain-right {
        transform: translateX(0);
    }

    /* ── Curtain loading indicator ────────────────────────────────────────── */
    /*
   * Sits in the center of the overlay (between the two panels) and is only
   * visible when the curtain is fully closed. Gives the user feedback that
   * something is happening behind the curtain.
   */

    .curtain-loader {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        /* Hidden by default — only shown when curtain is closed */
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    #curtain-overlay.is-closed .curtain-loader,
    #curtain-overlay.is-pre-closed .curtain-loader {
        opacity: 1;
    }

    .curtain-spinner {
        width: 44px;
        height: 44px;
        border: 3px solid rgba(200, 168, 75, 0.25);
        border-top-color: #c8a84b;
        border-radius: 50%;
        animation: curtain-spin 0.9s linear infinite;
    }

    .curtain-loader-text {
        color: rgba(200, 168, 75, 0.85);
        font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 0.875rem;
        letter-spacing: 0.08em;
        margin: 0;
        text-transform: uppercase;
    }

    @keyframes curtain-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Open keyframes (panels slide OUT to reveal content) ─────────────── */
    /* 110 % ensures the panel edge is fully off-screen with no clipping gap.  */

    @keyframes curtain-open-left {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-110%);
        }
    }

    @keyframes curtain-open-right {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(110%);
        }
    }

    /*
   * Ease-out for opening: starts fast (momentum from closed position),
   * decelerates — mimics the deceleration of a weighted velvet curtain.
   */
    #curtain-overlay.is-opening .curtain-left {
        animation: curtain-open-left 1.1s cubic-bezier(0.22, 1, 0.36, 1)
            forwards;
    }

    #curtain-overlay.is-opening .curtain-right {
        animation: curtain-open-right 1.1s cubic-bezier(0.22, 1, 0.36, 1)
            forwards;
    }

    /* Remove from layout after animation so it can never block pointer events */
    #curtain-overlay.is-done {
        display: none;
    }
</style>
